{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "SstState",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:PutParameter", "ssm:DeleteParameter"],
      "Resource": "arn:aws:ssm:*:ACCOUNT_ID:parameter/sst/*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::claude-ec2-*",
        "arn:aws:s3:::claude-ec2-*/*",
        "arn:aws:s3:::sst-asset-*",
        "arn:aws:s3:::sst-asset-*/*"
      ]
    },
    {
      "Sid": "Functions",
      "Effect": "Allow",
      "Action": ["lambda:*"],
      "Resource": "arn:aws:lambda:eu-west-1:ACCOUNT_ID:function:claude-ec2-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:*"],
      "Resource": "arn:aws:logs:eu-west-1:ACCOUNT_ID:log-group:*"
    },
    {
      "Sid": "ApiGateway",
      "Effect": "Allow",
      "Action": ["apigateway:*"],
      "Resource": "arn:aws:apigateway:eu-west-1::/*"
    },
    {
      "Sid": "Edge",
      "Effect": "Allow",
      "Action": ["cloudfront:*", "cloudfront-keyvaluestore:*", "acm:*", "route53:*"],
      "Resource": "*"
    },
    {
      "Sid": "Auth",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool", "cognito-idp:GetUserPoolMfaConfig", "cognito-idp:ListTagsForResource",
        "cognito-idp:CreateUserPoolClient", "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient", "cognito-idp:DeleteUserPoolClient"
      ],
      "Resource": "arn:aws:cognito-idp:eu-west-1:ACCOUNT_ID:userpool/eu-west-1_IVai0KEAA"
    },
    {
      "Sid": "Ec2Read",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetLaunchTemplateData"],
      "Resource": "*"
    },
    {
      "Sid": "LaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:DeleteLaunchTemplateVersions",
        "ec2:CreateTags", "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:eu-west-1:ACCOUNT_ID:launch-template/lt-09036c7e82f2ca477"
    },
    {
      "Sid": "LaunchTemplateImage",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:eu-west-1::parameter/aws/service/canonical/*"
    },
    {
      "Sid": "Roles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole", "iam:GetRole", "iam:UpdateRole", "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies",
        "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole", "iam:TagRole", "iam:UntagRole", "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/claude-ec2-*"
    },
    {
      "Sid": "RolesWithBoundary",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:AttachRolePolicy", "iam:PutRolePermissionsBoundary"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/claude-ec2-*",
      "Condition": {
        "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/claude-ec2-Boundary" }
      }
    },
    {
      "Sid": "PassFunctionRoles",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/claude-ec2-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    }
  ]
}
